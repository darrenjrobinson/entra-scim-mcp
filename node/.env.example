# Local development credentials for the dev scripts in scripts/.
# Copy to .env (gitignored) and fill in. Never committed, never published.
#
# Only scripts/live-smoke.ts and scripts/dev-server.mjs read this file. The
# published server reads process.env only, so a stray .env can never leak into
# a real MCP client session.
#
# Requires on the app registration (Microsoft Graph, application permissions,
# admin consent granted) -- see "Prerequisites" in README.md:
#   User.ReadWrite.All, Group.ReadWrite.All,
#   CustomSecAttributeAssignment.ReadWrite.All, CustomSecAttributeDefinition.Read.All,
#   User-LifeCycleInfo.ReadWrite.All

# --- Required for a real tenant ---
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Set exactly one of these two. The secret is the VALUE shown once at creation,
# not the secret ID.
ENTRA_CLIENT_SECRET=
# ENTRA_CLIENT_CERT_PATH=./certs/entra-scim.pem
# ENTRA_CLIENT_CERT_PASSWORD=

# --- live-smoke.ts only ---
# Verified domain the throwaway scim-smoke-* test identities are created in.
ENTRA_SCIM_SMOKE_DOMAIN=example.com

# Optional. Set both to cover the two Custom Security Attribute tools; the
# smoke run skips them otherwise. Create the set + attribute first in
# Entra portal > Protection > Custom security attributes.
# ENTRA_SCIM_SMOKE_CSA_SET=Engineering
# ENTRA_SCIM_SMOKE_CSA_ATTR=ProjectCode
# Or declare the whole set, so --csa-only covers every data type plus removal.
# Types: bool, int, string, string[] (multi-valued). A test value is derived
# per type, so the run proves the API accepts each one.
# ENTRA_SCIM_SMOKE_CSA_ATTRS=isManaged:bool,accountType:string,trustLevel:int,locations:string[]
# CSAs are typed and the API rejects the wrong type. true/false become a JSON
# boolean and a bare integer becomes a number; anything else is sent as a
# string. Defaults to a string, so set this for Boolean or Integer attributes.
# ENTRA_SCIM_SMOKE_CSA_VALUE=true

# --- Dev overrides (leave unset for a real tenant) ---
# ENTRA_SCIM_BASE_URL=http://127.0.0.1:8990
# ENTRA_SCIM_STATIC_TOKEN=dev-token
# ENTRA_SCIM_DRY_RUN=1
